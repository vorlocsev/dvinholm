                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1AD4ED" Offset="0" />
                                                        <GradientStop Color="#6A6DDB" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="124" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DtcCodeHeading" Text="Код DTC" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DtcDescriptionHeading" Grid.Column="1" Text="Описание" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DtcStatusHeading" Grid.Column="2" Text="Статус" FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock x:Name="DtcTableSummary" Text="Коды не считывались в текущем диагностическом контексте." Foreground="#9CD8ED" TextWrapping="Wrap" />
                                            <ListView x:Name="DtcRecordsView" Height="260" SelectionMode="Single" SelectionChanged="DtcRecordsView_SelectionChanged" AutomationProperties.Name="Коды неисправностей выбранного ECU" ToolTipService.ToolTip="Только реально считанные DTC одного ECU. Нет подтверждённого словаря причин Volvo.">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Padding="0,9,0,9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="124" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" Foreground="#8BDBF4" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#F0D3A0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock x:Name="DtcEvidenceDisclaimer" Text="Коды появляются только после явного чтения. Подтверждённого каталога описаний Volvo пока нет. Ни одна ошибка здесь не подставляется автоматически." Foreground="#A8C7DF" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DtcDetailsPane" Grid.Column="1" Background="#102943"
                                            BorderBrush="#2B5878" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="7">
                                        <Border x:Name="DtcDetailsAccent" Height="3" CornerRadius="2"
                                                IsHitTestVisible="False" Background="#5F71C5" />
                                        <TextBlock x:Name="DtcDetailsHeading" Text="Подробности" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DtcSelectedRecordDetails" Text="Выберите считанную ошибку, чтобы посмотреть сырые данные и маску статуса." Foreground="#B2CBDE" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="DtcDetailsEvidence" Text="После чтения реальные 24-битные коды DTC, маски статуса и поддерживаемые ECU биты появятся в панели «Результат операции» ниже. Описания причин и рекомендаций требуют проверенного каталога для выбранной модели." Foreground="#B2CBDE" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    </Border>
                                    </Grid>
                                    <Button x:Name="DtcCheckAddressesButton" Content="Проверить адреса ECU" Tag="DiagnosticsWorkspace" Click="WorkspaceNavigate_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="Только навигация к параметрам подключения. Запросы к автомобилю не отправляются." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="CanMonitorPage" Visibility="Collapsed" Spacing="4">
                            <Border Style="{StaticResource AuroraCard}">
                                <StackPanel Spacing="18">
                                    <TextBlock x:Name="CanMonitorHeading" Text="Поток CAN" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CanMonitorIntro" Text="Запускайте и останавливайте наблюдение независимо от переходов между разделами." Foreground="#9EB8CC" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="StartButton" Content="Start monitor" Click="Start_Click" VerticalAlignment="Bottom" IsEnabled="False" Background="#0865C7" BorderBrush="#348DEA" />
                                    </StackPanel>
                                    <Grid x:Name="DeveloperMonitorHost" ColumnSpacing="10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid ColumnSpacing="16" RowSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="IdFilter" Header="ID filter (hex)" PlaceholderText="7E0,7E8" TextChanged="Filter_Changed" Grid.Column="0" />
                                        <Button x:Name="CanMonitorClearButton" Grid.Column="1" Content="Clear" Click="Clear_Click" VerticalAlignment="Bottom" />
                                        <Button x:Name="HardwareFilterButton" Content="Apply HW filter" Click="HardwareFilter_Click" VerticalAlignment="Bottom" IsEnabled="False" Grid.Column="2" />
                                        <Button x:Name="CanMonitorCsvButton" Grid.Column="3" Content="CSV log" Click="Csv_Click" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Button x:Name="CanRxSummaryButton" Content="RX summary" Click="CanRxSummary_Click" ToolTipService.ToolTip="Review buffered CAN RX ID/DLC counts without frame data. Copy only by explicit approval. No diagnostic requests." />
                                        <Button x:Name="CanTraceInspectButton" Content="Inspect trace" Click="InspectCanCsv_Click" ToolTipService.ToolTip="Offline review of a selected Dvinholm CAN CSV or metadata-only J2534 JSONL. Never connects or changes the monitor. Sensitive identifiers and payload stay hidden." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="24">
                                        <TextBlock x:Name="FrameRateText" VerticalAlignment="Center" Text="0 frames/s" />
                                        <TextBlock x:Name="FrameCountText" VerticalAlignment="Center" Text="0 shown / 0 rx" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="DroppedFrameText" VerticalAlignment="Center" Text="0 dropped" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <ListView x:Name="FramesView" SelectionMode="None" Height="380">
                                        <ListView.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Timestamp (ms)" />
                                                <TextBlock Grid.Column="1" Text="ID" />
                                                <TextBlock Grid.Column="2" Text="Type" />
                                                <TextBlock Grid.Column="3" Text="DLC" />
                                                <TextBlock Grid.Column="4" Text="Data" />
                                            </Grid>
                                        </ListView.Header>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="55" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Timestamp}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Type}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Dlc}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Data}" FontFamily="Consolas" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ProfilesPage" Visibility="Collapsed" Spacing="4">
                            <StackPanel x:Name="DevelopmentProfileTools" Spacing="8" Visibility="Collapsed" />
                            <Border Style="{StaticResource AuroraCard}">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ProfileSearch" Grid.Column="0" Header="Find ECU profile" PlaceholderText="Name, ID, CAN ID, DID or source" TextChanged="ProfileSearch_TextChanged" />
                                        <ComboBox x:Name="ProfileSelector" Grid.Column="1" Header="ECU profiles" PlaceholderText="Select profile" SelectionChanged="ProfileSelector_SelectionChanged" />
                                        <CheckBox x:Name="MarkedVerifiedOnly" Grid.Column="0" Content="Marked verified only" Checked="MarkedVerifiedOnly_Changed" Unchecked="MarkedVerifiedOnly_Changed" VerticalAlignment="Bottom" Grid.Row="1" Grid.ColumnSpan="3" />
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="ProfileActionsPanel" Grid.Row="1" RowSpacing="6" ColumnSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CreateProfileButton" Grid.Row="0" Grid.Column="0" Content="New profile" HorizontalAlignment="Stretch" Click="CreateProfile_Click" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="EditProfileButton" Grid.Row="0" Grid.Column="1" Content="Edit selected" HorizontalAlignment="Stretch" Click="EditProfile_Click" IsEnabled="False" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="ProfileImportButton" Grid.Row="0" Grid.Column="2" Content="Import JSON" HorizontalAlignment="Stretch" Click="ImportProfiles_Click" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="ProfileExportButton" Grid.Row="0" Grid.Column="3" Content="Export JSON" HorizontalAlignment="Stretch" Click="ExportProfiles_Click" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="CaptureSnapshotButton" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Read + save snapshot" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Read selected profile DIDs and explicitly save a diagnostic JSON file. Not a restorable ECU backup." Click="CaptureSnapshot_Click" IsEnabled="False" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="InspectSnapshotButton" Grid.Row="1" Grid.Column="2" Content="Inspect snapshot" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Inspect local DID JSON without connecting, transmitting CAN, or restoring ECU data." Click="InspectSnapshot_Click" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                        <Button x:Name="CompareSnapshotsButton" Grid.Row="1" Grid.Column="3" Content="Compare snapshots" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Compare two local diagnostic JSON snapshots offline. Show only changed DID numbers, not their data." Click="CompareSnapshots_Click" ContentTemplate="{StaticResource AuroraWrapCaption}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="2" MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="EcuInfoText" Text="No ECU profile selected" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ConnectionPage" Visibility="Collapsed" Spacing="10">
                            <!-- Approved visual reference: adapter | CAN parameters | real connection state.
                                 Keep existing J2534 selection, handlers and architecture audit. -->
                            <Grid x:Name="ConnectionThreeCardGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ConnectionAdapterColumn" Width="1.1*" />
                                    <ColumnDefinition x:Name="ConnectionBusColumn" Width="0.95*" />
                                    <ColumnDefinition x:Name="ConnectionStatusColumn" Width="1.05*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ConnectionAdapterPane" Grid.Column="0"
                                        Style="{StaticResource AuroraCard}" Margin="0">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="ConnectionAdapterHeadingGrid" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE950;"
                                                      Foreground="#55CEED" FontSize="21" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" x:Name="ConnectionPageHeading" TextWrapping="Wrap" Text="Интерфейс автомобиля"
                                                       FontSize="19" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock x:Name="ConnectionPageIntro"
                                                   Text="Выберите установленный J2534-адаптер и параметры канала."
                                                   Foreground="#A9C7DE" TextWrapping="Wrap" FontSize="12" />
                                        <ComboBox x:Name="J2534Devices" Header="Registered adapters"
                                                  DisplayMemberPath="Label" PlaceholderText="Select adapter"
                                                  SelectionChanged="J2534Device_SelectionChanged"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBox x:Name="DllPath" PlaceholderText="Path to compatible J2534 DLL"
                                                 Header="J2534 DLL" />
                                        <Expander x:Name="J2534ArchitectureAuditExpander"
                                                  Header="Аудит разрядности драйверов (офлайн)" IsExpanded="False">
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="J2534ArchitectureAuditText"
                                                           Text="Нажмите Refresh для повторной проверки зарегистрированных J2534 DLL."
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           FontFamily="Consolas" FontSize="12" />
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConnectionBusPane" Grid.Column="1"
                                        Style="{StaticResource AuroraCard}" Margin="0">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="ConnectionBusHeadingGrid" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;"
                                                      Foreground="#55CEED" FontSize="21" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" x:Name="ConnectionBusHeading" TextWrapping="Wrap"
                                                       Text="Параметры CAN" FontSize="19"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <ComboBox x:Name="BaudRate" Header="CAN speed" SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Volvo XC90 P2 HS-CAN guidance: through model year 2004 250 kbit/s; from model year 2005 500 kbit/s. Other networks differ. Verify actual model year, bus and adapter before connecting; Dvinholm does not adjust the speed automatically.">
                                            <ComboBoxItem Content="500 kbit/s" Tag="500000" />
                                            <ComboBoxItem Content="250 kbit/s" Tag="250000" />
                                            <ComboBoxItem Content="125 kbit/s" Tag="125000" />
                                        </ComboBox>
                                        <ComboBox x:Name="CanConnectionMode"
                                                  Header="CAN channel ID format" SelectedIndex="0"
                                                  Visibility="Collapsed"
                                                  ToolTipService.ToolTip="Select before connecting. Reconnect to change the physical channel format.">
                                            <ComboBoxItem Content="11-bit" />
                                            <ComboBoxItem Content="29-bit" />
                                        </ComboBox>
                                        <TextBlock x:Name="ConnectionBusEvidenceNote"
                                                   Text="Скорость и формат CAN должны соответствовать проверенному автомобилю."
                                                   TextWrapping="Wrap" Foreground="#A9BDD3" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConnectionStatusPane" Grid.Column="2"
                                        Style="{StaticResource AuroraCard}" Margin="0">
                                    <StackPanel Spacing="14">
                                        <Grid x:Name="ConnectionDriverHeadingGrid" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE753;"
                                                      Foreground="#55CEED" FontSize="21" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" x:Name="ConnectionDriverHeading" TextWrapping="Wrap"
                                                       Text="Сведения об адаптере" FontSize="19"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock x:Name="ConnectionSessionState"
                                                   Text="{Binding Text, ElementName=ShellConnectionText}"
                                                   FontSize="17" Foreground="#728FA8" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ConnectionDriverIntro" TextWrapping="Wrap"
                                                   Text="Информация текущего подключения."
                                                   Foreground="#A9C7DE" FontSize="12" />
                                        <TextBlock x:Name="AdapterMetadataText"
                                                   Text="J2534 adapter details: disconnected."
                                                   FontSize="12" Foreground="#C1D7E8" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   ToolTipService.ToolTip="Unverified values returned by the driver. Local diagnostic details, not an ECU identity or authorization." />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ConnectionRefreshButton" Grid.Column="0"
                                                    Content="Refresh" Click="RefreshJ2534Devices_Click"
                                                    HorizontalAlignment="Stretch" />
                                            <Button x:Name="ConnectButton" Grid.Column="1"
                                                    Content="Connect" Click="Connect_Click"
                                                    HorizontalAlignment="Stretch"
                                                    Background="#0865C7" BorderBrush="#348DEA" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="DiagnosticResultsCard" Visibility="Collapsed" Style="{StaticResource AuroraCard}">
                            <StackPanel Spacing="18">
                                <TextBlock x:Name="DiagnosticResultHeading" Text="Результат операции" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="DiagnosticResultIntro" Text="Данные отображаются локально. Проверьте содержимое перед передачей." Foreground="#9EB8CC" />
                                <StackPanel x:Name="StatusPanel" Spacing="6">
                                    <Expander x:Name="DiagnosticResultExpander" Header="Diagnostic read result (VIN / DID / DTC, review before sharing)" IsExpanded="False">
                                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="DiagnosticResultText" Text="No completed UDS read in this session." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" />
                                        </ScrollViewer>
                                    </Expander>
                                    <Button x:Name="ClearDiagnosticResultButton" Content="Clear diagnostic result" HorizontalAlignment="Right" Click="ClearDiagnosticResult_Click" ToolTipService.ToolTip="Clear the last VIN/DID/DTC payload and ignore any pending result. Does not contact the ECU." />
                                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="StatusText" Text="Disconnected" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Continuous low-profile status strip from the approved Aurora shell.
                     The indicator stays neutral unless a real session is connected. -->
                <Border x:Name="ShellStatusBar" Grid.Row="2" Background="#071B2F"
                        BorderBrush="#2C5778" BorderThickness="0,1,0,0" Padding="28,9">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusFooterDot" Text="●" FontSize="12"
                                   Foreground="#728FA8" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShellStatusText" Grid.Column="1"
                                   Text="{Binding Text, ElementName=StatusText}"
                                   Foreground="#C0D5E7" FontSize="12" MaxLines="2"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusFooterVersion" Grid.Column="2"
                                   Text="Dvinholm" Foreground="#80AFC9" FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>