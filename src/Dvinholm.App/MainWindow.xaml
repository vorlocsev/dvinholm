<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:Dvinholm.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Dvinholm.App.MainWindow" Title="Dvinholm">
    <Grid x:Name="RootLayout" Background="#071827" RequestedTheme="Dark">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellLayoutStates">
                <VisualState x:Name="ShellWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ShellCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellSidebarColumn.Width" Value="64" />
                        <Setter Target="SidebarBrand.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarFooter.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarNavPanel.Padding" Value="6,12" />
                        <Setter Target="SidebarHomeButton.Content" Value="⌂" />
                        <Setter Target="SidebarHomeButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="ShellNavCemPinLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavConfigLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavDtcLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavEcuLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavDiagnosticsLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavMonitorLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavProfilesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavConnectionLabel.Visibility" Value="Collapsed" />
                        <Setter Target="WorkspaceHeaderGrid.Margin" Value="12,12,12,12" />
                        <Setter Target="WorkspaceHeaderGrid.RowSpacing" Value="8" />
                        <Setter Target="WorkspaceTitle.FontSize" Value="23" />
                        <Setter Target="WorkspaceHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="WorkspaceHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="WorkspaceHeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="WorkspacePageContainer.Padding" Value="12,0,12,16" />
                        <Setter Target="ShellStatusBar.Padding" Value="12,10" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.Resources>
            <Style x:Key="AuroraButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="#173650" />
                <Setter Property="BorderBrush" Value="#2B506C" />
                <Setter Property="Foreground" Value="#EDF6FF" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource AuroraButton}" />
            <Style x:Key="AuroraNav" TargetType="Button" BasedOn="{StaticResource AuroraButton}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E8F2FC" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AuroraCard" TargetType="Border">
                <Setter Property="Background" Value="#0D263B" />
                <Setter Property="BorderBrush" Value="#23445F" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <DataTemplate x:Key="AuroraWrapCaption">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellSidebarColumn" Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#0A2038" BorderBrush="#244B73" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarNavPanel" Padding="16,24" Spacing="5">
                        <StackPanel x:Name="SidebarBrand" Margin="6,0,0,18" Spacing="4">
                            <TextBlock Text="DVINHOLM" FontSize="25" FontWeight="Bold" />
                            <TextBlock Text="DIAGNOSTICS · CONTROL" FontSize="10" Foreground="#8AB9D9" />
                        </StackPanel>
                        <Button x:Name="SidebarHomeButton" Content="⌂   Главная" ToolTipService.ToolTip="Главная" AutomationProperties.Name="Главная" Style="{StaticResource AuroraNav}" Click="DashboardReturn_Click" Background="#0865C7" />
                        <Button Tag="CemPinReadiness" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="CEM PIN" ToolTipService.ToolTip="CEM PIN">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavCemPinLabel" Text="CEM PIN" />
                            </StackPanel>
                        </Button>
                        <Button Tag="CemConfigurationCatalog" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Конфигурация CEM" ToolTipService.ToolTip="Конфигурация CEM">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavConfigLabel" Text="Конфигурация CEM" />
                            </StackPanel>
                        </Button>
                        <Button Tag="DtcFaults" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Ошибки / DTC" ToolTipService.ToolTip="Ошибки / DTC">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavDtcLabel" Text="Ошибки / DTC" />
                            </StackPanel>
                        </Button>
                        <Button Tag="EcuWorkspace" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Блоки ECU" ToolTipService.ToolTip="Блоки ECU">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavEcuLabel" Text="Блоки ECU" />
                            </StackPanel>
                        </Button>
                        <Button Tag="DiagnosticsWorkspace" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Диагностика" ToolTipService.ToolTip="Диагностика">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavDiagnosticsLabel" Text="Диагностика" />
                            </StackPanel>
                        </Button>
                        <Button Tag="CanMonitor" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="CAN монитор" ToolTipService.ToolTip="CAN монитор">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavMonitorLabel" Text="CAN монитор" />
                            </StackPanel>
                        </Button>
                        <Button Tag="EcuProfiles" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Профили ECU" ToolTipService.ToolTip="Профили ECU">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavProfilesLabel" Text="Профили ECU" />
                            </StackPanel>
                        </Button>
                        <Button Tag="J2534Connection" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Подключение" ToolTipService.ToolTip="Подключение">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavConnectionLabel" Text="Подключение" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="SidebarFooter" Grid.Row="1" Padding="22,18" Spacing="6">
                    <TextBlock Text="WINUI 3 · WINDOWS x86" FontSize="10" Foreground="#80A5C3" />
                    <TextBlock Text="Обновления через Launcher" FontSize="11" Foreground="#80A5C3" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <local:AuroraHome x:Name="AuroraLanding" />
            <Grid x:Name="AuroraWorkspaceHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkspaceHeaderGrid" Margin="28,24,28,20" ColumnSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="DVINHOLM / РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" CharacterSpacing="120" Foreground="#65BFF2" />
                        <TextBlock x:Name="WorkspaceTitle" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock x:Name="WorkspaceDescription" Foreground="#9EB8CC" MaxWidth="760" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="WorkspaceHeaderActions" Grid.Column="1" Spacing="10">
                        <Button Tag="J2534Connection" Click="WorkspaceNavigate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" Foreground="#66CAED" />
                                <TextBlock x:Name="ShellConnectionText" Text="Не подключено" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelUdsButton" Visibility="Collapsed" Content="Отменить операцию" IsEnabled="False" Click="CancelUds_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="WorkspacePageContainer" Padding="28,0,28,24" MaxWidth="1200" HorizontalAlignment="Stretch">
                        <StackPanel x:Name="CemPinPage" Visibility="Collapsed" Spacing="4">
                            <Border Style="{StaticResource AuroraCard}" x:Name="CemPinIdentityCard" Visibility="Collapsed">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="01  ·  Идентификация CEM" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Прочитайте номер блока перед поиском PIN. Для экспериментального маршрута нужен канал 500 кбит/с, 29 бит." Foreground="#9EB8CC" />
                                    <Button x:Name="CemPartNumberReadButton" Content="Read CEM P/N (experimental HS-CAN)" HorizontalAlignment="Left" ToolTipService.ToolTip="Connect a 500 kbit/s, 29-bit channel; stop the monitor and remove user hardware filters first. Source-defined experimental read, not verified CEM or PIN support." Visibility="Collapsed" IsEnabled="False" Click="ReadCemPartNumber_Click" Background="#0865C7" BorderBrush="#348DEA" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AuroraCard}" x:Name="CemPinSearchCard" Visibility="Collapsed">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="02  ·  Поиск и сохранённые PIN" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Задайте диапазон попыток. Найденные PIN сохраняются с защитой текущего пользователя Windows." Foreground="#9EB8CC" />
                                    <StackPanel x:Name="CemPinLivePanel" Spacing="6" Visibility="Collapsed" RequestedTheme="Dark">
                                        <Grid ColumnSpacing="12" RowSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="CemPinRangeStart" Header="Search starting position" Text="0" MaxLength="12" TextChanged="CemPinRangeChanged" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" />
                                            <TextBox x:Name="CemPinRangeCount" Header="Attempt limit (1–10000)" Text="1000" MaxLength="5" TextChanged="CemPinRangeChanged" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
                                            <Button x:Name="CemPinReadButton" Content="Read CEM PIN (experimental)" IsEnabled="False" Click="ReadCemPin_Click" VerticalAlignment="Bottom" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Background="#0865C7" BorderBrush="#348DEA" />
                                            <Button x:Name="CemPinRevealButton" Content="Reveal for 15 seconds" IsEnabled="False" Click="RevealCemPin_Click" VerticalAlignment="Bottom" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="CemPinSavedButton" Content="Saved PINs" Visibility="Collapsed" HorizontalAlignment="Left" Click="SavedCemPins_Click" />
                                            <TextBlock x:Name="CemPinResultText" Grid.Column="1" Text="No PIN result." FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="False" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AuroraCard}">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="Совместимость и доступ" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Сведения о процедуре и ограничениях текущей реализации." Foreground="#9EB8CC" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="P2PinReviewButton" Grid.Row="4" Content="P2 CEM PIN readiness (offline review)" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Cancellable offline evidence checklist only. No PIN extraction, credential entry or vehicle operation." Click="P2PinReview_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="CemConfigPage" Visibility="Collapsed" Spacing="4">
                            <Border Style="{StaticResource AuroraCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Конфигурация CEM" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Каталог Volvo P2 · офлайн. Выбор пункта показывает источник, но не читает или меняет автомобиль." Foreground="#9EB8CC" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="P2ConfigCatalogButton" Grid.Column="0" Content="Источники (offline)" Click="P2ConfigCatalog_Click" HorizontalAlignment="Stretch" Background="#0B5F81" ToolTipService.ToolTip="Open reference sources offline; no vehicle queries, PIN or configuration writes." />
                                        <Button Grid.Column="1" Content="Резервная копия" IsEnabled="False" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Нет проверенной операции чтения конфигурации CEM." />
                                        <Button Grid.Column="2" Content="Сравнить" IsEnabled="False" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Нет считанной конфигурации и проверенного резервного снимка." />
                                        <Button Grid.Column="3" Content="Подготовить изменения" IsEnabled="False" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Не проверены байтовая карта, допустимые значения и зависимости." />
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid MinWidth="730" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="163" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="235" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#112B47" BorderBrush="#315572" BorderThickness="1" CornerRadius="9" Padding="10">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Категории" FontSize="17" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="CemConfigCategory" Header="Группа" HorizontalAlignment="Stretch" SelectionChanged="CemConfigCategory_SelectionChanged" />
                                                    <TextBox x:Name="CemConfigSearch" Header="Найти параметр" PlaceholderText="Код или название" MaxLength="80" TextChanged="CemConfigSearch_TextChanged" />
                                                    <TextBlock Text="Данные получены из локального каталога источников. Совместимость не подтверждена." Foreground="#A5C0D4" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#112B47" BorderBrush="#315572" BorderThickness="1" CornerRadius="9" Padding="10">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="Параметры и значения" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CemConfigCount" Text="Загрузка локальных данных…" Foreground="#9CC9E1" TextWrapping="Wrap" />
                                                    <ListView x:Name="CemConfigResults" Height="310" SelectionMode="Single" SelectionChanged="CemConfigResults_SelectionChanged">
                                                        <ListView.Header>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="97" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Параметр (ID / название)" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="Текущее" FontWeight="SemiBold" />
                                                            </Grid>
                                                        </ListView.Header>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="8" Padding="2,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="97" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{Binding Code}" Foreground="#74DAF1" FontFamily="Consolas" FontSize="12" />
                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Current}" TextWrapping="Wrap" Foreground="#C8D6E8" FontSize="12" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#112B47" BorderBrush="#315572" BorderThickness="1" CornerRadius="9" Padding="10">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Описание" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CemConfigDetailTitle" Text="Выберите параметр" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="CemConfigDetailCode" Text="Код и источник появятся после выбора." FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="CemConfigDetailSource" Text="" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="CemConfigDetailEvidence" Text="" FontSize="12" TextWrapping="Wrap" MaxLines="4" />
                                                    <TextBlock x:Name="CemConfigDetailValues" Text="Значения автомобиля не считывались." FontSize="12" Foreground="#9CC9E1" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="CemConfigDetailSafety" Text="Изменение и запись недоступны до проверки протокола и резервного восстановления." FontSize="12" Foreground="#EBC280" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                    <Border Background="#10253D" CornerRadius="7" Padding="11" BorderBrush="#2B5878" BorderThickness="1">
                                        <TextBlock Text="Чтение, изменение и запись CEM пока заблокированы. Никаких реальных значений, адресов или прав на запись этот каталог не подтверждает." TextWrapping="Wrap" Foreground="#C7DFF2" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="EcuPage" Visibility="Collapsed" Spacing="4">
                            <Border Style="{StaticResource AuroraCard}">
                                <StackPanel Spacing="18">
                                    <TextBlock Text="Обнаружение блоков" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Пассивное наблюдение ответов. Выбор записи не подтверждает идентичность блока и не отправляет запрос." Foreground="#9EB8CC" />
                                    <Grid ColumnSpacing="16" RowSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="EcuSelector" PlaceholderText="Observed response" IsEnabled="False" SelectionChanged="EcuSelector_SelectionChanged" ToolTipService.ToolTip="Selection does not send a request or verify the inferred request address." Grid.Column="0" />
                                        <Button x:Name="DiscoverButton" Content="Discover ECUs" Click="Discover_Click" IsEnabled="False" Grid.Column="1" />
                                        <Button x:Name="CancelDiscoveryButton" Content="Cancel scan" Click="CancelDiscovery_Click" IsEnabled="False" Grid.Column="2" />
                                    </Grid>
                                    <TextBlock x:Name="DiscoveryStatus" VerticalAlignment="Center" Text="Not scanned" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="250" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#102A44" BorderBrush="#2B5776" BorderThickness="1" CornerRadius="9" Padding="12">
                                            <StackPanel Spacing="9">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Карта автомобиля" FontSize="18" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="EcuVehicleModel" Grid.Column="1" Width="150" SelectedIndex="0" SelectionChanged="EcuVehicleModel_SelectionChanged" AutomationProperties.Name="Схема автомобиля">
                                                        <ComboBoxItem Content="XC90 · P2" />
                                                        <ComboBoxItem Content="XC70 · P3" />
                                                    </ComboBox>
                                                </Grid>
                                                <Viewbox Stretch="Uniform" MaxHeight="235" HorizontalAlignment="Stretch">
                                                    <Grid Width="640" Height="255">
                                                        <Canvas x:Name="EcuP2SideProfile" Width="640" Height="255">
                                                            <Path Data="M30,156 L59,145 L82,112 Q95,93 128,87 L170,82 Q202,43 245,43 L418,43 Q471,53 501,102 L550,116 Q590,129 596,148 L603,180 L567,186 L53,186 L24,176 Z" Fill="#173D56" Stroke="#31C7EA" StrokeThickness="3" />
                                                            <Path Data="M205,83 L241,52 L409,52 Q443,54 468,98 L205,98 Z" Fill="#0B1B33" Stroke="#83B8D4" StrokeThickness="2" />
                                                            <Path Data="M320,53 L320,98 M461,99 L461,146 M197,99 L197,165 M348,102 L348,165" Stroke="#478AAE" StrokeThickness="2" />
                                                            <Path Data="M28,163 L601,163" Stroke="#64C8EC" StrokeThickness="2" Opacity=".7" />
                                                            <Ellipse Canvas.Left="115" Canvas.Top="150" Width="88" Height="88" Fill="#0A1526" Stroke="#75A8BF" StrokeThickness="7" />
                                                            <Ellipse Canvas.Left="466" Canvas.Top="150" Width="88" Height="88" Fill="#0A1526" Stroke="#75A8BF" StrokeThickness="7" />
                                                            <Ellipse Canvas.Left="148" Canvas.Top="184" Width="23" Height="23" Fill="#18354E" Stroke="#BEDAE7" StrokeThickness="3" />
                                                            <Ellipse Canvas.Left="499" Canvas.Top="184" Width="23" Height="23" Fill="#18354E" Stroke="#BEDAE7" StrokeThickness="3" />
                                                        </Canvas>
                                                        <Canvas x:Name="EcuP3SideProfile" Width="640" Height="255" Visibility="Collapsed">
