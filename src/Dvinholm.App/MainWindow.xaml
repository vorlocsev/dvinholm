<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:Dvinholm.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Dvinholm.App.MainWindow" Title="Dvinholm">
    <Grid x:Name="RootLayout" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#071625" Offset="0" />
                <GradientStop Color="#0A1D32" Offset="0.62" />
                <GradientStop Color="#13152F" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellLayoutStates">
                <VisualState x:Name="ShellWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ShellCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ShellSidebarColumn.Width" Value="64" />
                        <Setter Target="SidebarBrand.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarCompactBrand.Visibility" Value="Visible" />
                        <Setter Target="SidebarFooter.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarNavPanel.Padding" Value="6,12" />
                        <Setter Target="ShellNavCemPinLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavConfigLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavDtcLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavEcuLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavConnectionLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ShellNavUpdatesLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SidebarConnectionButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarConnectionButton.Padding" Value="0,9" />
                        <Setter Target="SidebarUpdatesButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarUpdatesButton.Padding" Value="0,9" />
                        <Setter Target="SidebarCemPinButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarCemPinButton.Padding" Value="0,9" />
                        <Setter Target="SidebarCemConfigButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarCemConfigButton.Padding" Value="0,9" />
                        <Setter Target="SidebarDtcButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarDtcButton.Padding" Value="0,9" />
                        <Setter Target="SidebarEcuButton.HorizontalContentAlignment" Value="Center" />
                        <Setter Target="SidebarEcuButton.Padding" Value="0,9" />
                        <Setter Target="WorkspaceHeaderGrid.Margin" Value="12,10,12,10" />
                        <Setter Target="WorkspaceHeaderGrid.MinHeight" Value="116" />
                        <Setter Target="SidebarAuroraRibbon.Opacity" Value="0.12" />
                        <Setter Target="WorkspaceHeaderGrid.RowSpacing" Value="8" />
                        <Setter Target="WorkspaceTitle.FontSize" Value="23" />
                        <Setter Target="WorkspaceHeaderActions.(Grid.Row)" Value="1" />
                        <Setter Target="WorkspaceHeaderActions.(Grid.Column)" Value="0" />
                        <Setter Target="WorkspaceHeaderActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="WorkspaceHeaderActions.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="WorkspaceHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="WorkspaceHeaderActions.Margin" Value="16,0,16,10" />
                        <Setter Target="WorkspaceHeaderActions.Spacing" Value="8" />
                        <Setter Target="WorkspaceHeaderCopy.Margin" Value="16,10,16,0" />
                        <Setter Target="WorkspacePageContainer.Padding" Value="12,0,12,16" />
                        <Setter Target="ShellStatusBar.Padding" Value="12,10" />
                        <Setter Target="StatusFooterVersion.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- 640-DIP first fold: keep page identity and genuine session/language
                 controls visible, but let per-page cards own the explanation. -->
            <!-- Keep the wide banner shallow when enough real client width
                 exists. The 980..1279 DIP right column stays vertically stacked
                 so longer localized page titles keep usable horizontal room. -->
            <VisualStateGroup x:Name="HeaderActionDensityStates">
                <VisualState x:Name="HeaderActionsInline">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceHeaderActions.Orientation" Value="Horizontal" />
                        <Setter Target="WorkspaceHeaderActions.Spacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HeaderActionsStacked">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="HeaderReadabilityStates">
                <VisualState x:Name="HeaderFullContext">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderTitleOnly">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WorkspaceScopeLabel.Visibility" Value="Collapsed" />
                        <Setter Target="WorkspaceDescription.Visibility" Value="Collapsed" />
                        <Setter Target="WorkspaceHeaderCopy.Spacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CemReferenceResponsiveStates">
                <VisualState x:Name="CemReferenceWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CemReferenceStacked">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CemReferenceCategoryColumn.Width" Value="*" />
                        <Setter Target="CemReferenceValuesColumn.Width" Value="0" />
                        <Setter Target="CemReferenceDetailColumn.Width" Value="0" />
                        <Setter Target="CemReferenceValuesPane.(Grid.Column)" Value="0" />
                        <Setter Target="CemReferenceValuesPane.(Grid.Row)" Value="1" />
                        <Setter Target="CemReferenceDetailPane.(Grid.Column)" Value="0" />
                        <Setter Target="CemReferenceDetailPane.(Grid.Row)" Value="2" />
                        <Setter Target="CemConfigActionThirdColumn.Width" Value="0" />
                        <Setter Target="CemConfigActionFourthColumn.Width" Value="0" />
                        <Setter Target="CemConfigActionFifthColumn.Width" Value="0" />
                        <Setter Target="CemConfigActionSixthColumn.Width" Value="0" />
                        <Setter Target="CemConfigBackupButton.(Grid.Column)" Value="0" />
                        <Setter Target="CemConfigBackupButton.(Grid.Row)" Value="1" />
                        <Setter Target="CemConfigCompareButton.(Grid.Column)" Value="1" />
                        <Setter Target="CemConfigCompareButton.(Grid.Row)" Value="1" />
                        <Setter Target="CemConfigPrepareButton.(Grid.Column)" Value="0" />
                        <Setter Target="CemConfigPrepareButton.(Grid.Row)" Value="2" />
                        <Setter Target="CemConfigWriteButton.(Grid.Column)" Value="1" />
                        <Setter Target="CemConfigWriteButton.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ConnectionPanelStates">
                <VisualState x:Name="ConnectionThreeColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="ConnectionTwoColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionAdapterColumn.Width" Value="*" />
                        <Setter Target="ConnectionBusColumn.Width" Value="*" />
                        <Setter Target="ConnectionStatusColumn.Width" Value="0" />
                        <Setter Target="ConnectionStatusPane.(Grid.Column)" Value="0" />
                        <Setter Target="ConnectionStatusPane.(Grid.Row)" Value="1" />
                        <Setter Target="ConnectionStatusPane.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ConnectionVerticalPanels">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionAdapterColumn.Width" Value="*" />
                        <Setter Target="ConnectionBusColumn.Width" Value="0" />
                        <Setter Target="ConnectionStatusColumn.Width" Value="0" />
                        <Setter Target="ConnectionBusPane.(Grid.Column)" Value="0" />
                        <Setter Target="ConnectionBusPane.(Grid.Row)" Value="1" />
                        <Setter Target="ConnectionStatusPane.(Grid.Column)" Value="0" />
                        <Setter Target="ConnectionStatusPane.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="UpdatesPanelStates">
                <VisualState x:Name="UpdatesThreeColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="UpdatesTwoColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpdatesVersionColumn.Width" Value="*" />
                        <Setter Target="UpdatesChannelColumn.Width" Value="*" />
                        <Setter Target="UpdatesActionColumn.Width" Value="0" />
                        <Setter Target="UpdatesActionPane.(Grid.Column)" Value="0" />
                        <Setter Target="UpdatesActionPane.(Grid.Row)" Value="1" />
                        <Setter Target="UpdatesActionPane.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UpdatesVerticalPanels">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="UpdatesVersionColumn.Width" Value="*" />
                        <Setter Target="UpdatesChannelColumn.Width" Value="0" />
                        <Setter Target="UpdatesActionColumn.Width" Value="0" />
                        <Setter Target="UpdatesChannelPane.(Grid.Column)" Value="0" />
                        <Setter Target="UpdatesChannelPane.(Grid.Row)" Value="1" />
                        <Setter Target="UpdatesActionPane.(Grid.Column)" Value="0" />
                        <Setter Target="UpdatesActionPane.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DtcResponsiveStates">
                <VisualState x:Name="DtcTwoColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="DtcStacked">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DtcDetailColumn.Width" Value="0" />
                        <Setter Target="DtcDetailsPane.(Grid.Column)" Value="0" />
                        <Setter Target="DtcDetailsPane.(Grid.Row)" Value="1" />
                        <Setter Target="DtcActionReadColumn.Width" Value="0" />
                        <Setter Target="DtcActionClearColumn.Width" Value="0" />
                        <Setter Target="ReadDtcButton.(Grid.Column)" Value="0" />
                        <Setter Target="ReadDtcButton.(Grid.Row)" Value="1" />
                        <Setter Target="DtcClearButton.(Grid.Column)" Value="0" />
                        <Setter Target="DtcClearButton.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="EcuResponsiveStates">
                <VisualState x:Name="EcuThreeColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Intermediate Aurora composition keeps the RX index and actual
                     side-view car together; selected evidence spans the next row.
                     The read-only scan/tool controls retain their compact reflow. -->
                <VisualState x:Name="EcuTwoColumns">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EcuWorkbenchDetailColumn.Width" Value="0" />
                        <Setter Target="EcuWorkbenchDetailPane.(Grid.Column)" Value="0" />
                        <Setter Target="EcuWorkbenchDetailPane.(Grid.Row)" Value="1" />
                        <Setter Target="EcuWorkbenchDetailPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EcuToolsThirdColumn.Width" Value="0" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.Column)" Value="0" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.Row)" Value="1" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EcuScanToolbarActionColumn.Width" Value="*" />
                        <Setter Target="EcuScanToolbarCancelColumn.Width" Value="0" />
                        <Setter Target="EcuSelector.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DiscoverButton.(Grid.Column)" Value="0" />
                        <Setter Target="DiscoverButton.(Grid.Row)" Value="1" />
                        <Setter Target="DiscoverButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CancelDiscoveryButton.(Grid.Column)" Value="1" />
                        <Setter Target="CancelDiscoveryButton.(Grid.Row)" Value="1" />
                        <Setter Target="CancelDiscoveryButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EcuVerticalWorkspace">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EcuWorkbenchListColumn.Width" Value="*" />
                        <Setter Target="EcuWorkbenchVehicleColumn.Width" Value="0" />
                        <Setter Target="EcuWorkbenchDetailColumn.Width" Value="0" />
                        <Setter Target="EcuWorkbenchVehiclePane.(Grid.Column)" Value="0" />
                        <Setter Target="EcuWorkbenchVehiclePane.(Grid.Row)" Value="1" />
                        <Setter Target="EcuWorkbenchDetailPane.(Grid.Column)" Value="0" />
                        <Setter Target="EcuWorkbenchDetailPane.(Grid.Row)" Value="2" />
                        <Setter Target="EcuToolsThirdColumn.Width" Value="0" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.Column)" Value="0" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.Row)" Value="1" />
                        <Setter Target="EcuProfilesNavigateButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EcuScanToolbarActionColumn.Width" Value="0" />
                        <Setter Target="EcuScanToolbarCancelColumn.Width" Value="0" />
                        <Setter Target="DiscoverButton.(Grid.Column)" Value="0" />
                        <Setter Target="DiscoverButton.(Grid.Row)" Value="1" />
                        <Setter Target="DiscoverButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CancelDiscoveryButton.(Grid.Column)" Value="0" />
                        <Setter Target="CancelDiscoveryButton.(Grid.Row)" Value="2" />
                        <Setter Target="CancelDiscoveryButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.Resources>
            <LinearGradientBrush x:Key="AuroraPanelGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#122F4E" Offset="0" />
                <GradientStop Color="#0E263F" Offset="0.45" />
                <GradientStop Color="#0B1E33" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="AuroraButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="#173650" />
                <Setter Property="BorderBrush" Value="#2B506C" />
                <Setter Property="Foreground" Value="#EDF6FF" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource AuroraButton}" />
            <Style x:Key="AuroraNav" TargetType="Button" BasedOn="{StaticResource AuroraButton}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#E8F2FC" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AuroraCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AuroraPanelGradient}" />
                <Setter Property="BorderBrush" Value="#23445F" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <DataTemplate x:Key="AuroraWrapCaption">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
            </DataTemplate>
            <!-- Keep RU/EN action captions readable in dense Aurora footers. -->
            <Style x:Key="AuroraActionCaptionButton" TargetType="Button" BasedOn="{StaticResource AuroraButton}">
                <Setter Property="ContentTemplate" Value="{StaticResource AuroraWrapCaption}" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="8,9" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellSidebarColumn" Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="AuroraSidebarSurface" Background="#0A2038" BorderBrush="#244B73" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Northern-light atmosphere behind navigation, never CAN state or a hit target. -->
                <Border x:Name="SidebarAuroraBackdrop" Grid.RowSpan="2" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#091A2F" Offset="0" />
                            <GradientStop Color="#102744" Offset="0.48" />
                            <GradientStop Color="#1D1A3C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Viewbox x:Name="SidebarAuroraRibbon" Grid.RowSpan="2" Height="480"
                         HorizontalAlignment="Stretch" VerticalAlignment="Top" Stretch="Fill"
                         Opacity="0.24" IsHitTestVisible="False">
                    <Canvas Width="216" Height="480">
                        <Path Data="M-44,14 C42,41 77,94 130,148 C187,205 182,273 267,333"
                              Stroke="#15DDBD" StrokeThickness="24" StrokeStartLineCap="Round"
                              Fill="Transparent" Opacity="0.38" />
                        <Path Data="M-37,80 C53,108 69,164 149,226 C198,273 203,333 266,380"
                              Stroke="#3EB5EC" StrokeThickness="17" Fill="Transparent" Opacity="0.32" />
                        <Path Data="M-31,135 C37,173 82,211 145,271 C199,321 197,400 248,461"
                              Stroke="#9B81EB" StrokeThickness="20" Fill="Transparent" Opacity="0.24" />
                    </Canvas>
                </Viewbox>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarNavPanel" Padding="16,24" Spacing="5">
                        <!-- The approved Techno-North No.9 gull / gear artwork, not a temporary glyph. -->
                        <StackPanel x:Name="SidebarBrand" Margin="2,0,0,18" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Launcher-Northern-Emblem.svg" Width="48" Height="48"
                                   Stretch="Uniform" AutomationProperties.Name="Dvinholm" />
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Dvinholm" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock x:Name="SidebarBrandSubtitle" Text="АВТОДИАГНОСТИКА" FontSize="10"
                                           Foreground="#9CBED7" />
                            </StackPanel>
                        </StackPanel>
                        <Image x:Name="SidebarCompactBrand" Source="ms-appx:///Assets/Launcher-Northern-Emblem.svg"
                               Width="44" Height="44" Margin="0,0,0,14" HorizontalAlignment="Center"
                               Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Dvinholm" />
                        <Button x:Name="SidebarConnectionButton" Tag="J2534Connection" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Подключение" ToolTipService.ToolTip="Подключение">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavConnectionLabel" Text="Подключение" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarUpdatesButton" Style="{StaticResource AuroraNav}" Click="UnifiedUpdatesNavigate_Click" AutomationProperties.Name="Обновление" ToolTipService.ToolTip="Обновление">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavUpdatesLabel" Text="Обновление" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarCemPinButton" Tag="CemPinReadiness" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="CEM PIN" ToolTipService.ToolTip="CEM PIN">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavCemPinLabel" Text="CEM PIN" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarCemConfigButton" Tag="CemConfigurationCatalog" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Конфигурация CEM" ToolTipService.ToolTip="Конфигурация CEM">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavConfigLabel" Text="Конфигурация CEM" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarDtcButton" Tag="DtcFaults" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Ошибки (DTC)" ToolTipService.ToolTip="Ошибки (DTC)">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavDtcLabel" Text="Ошибки (DTC)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarEcuButton" Tag="EcuWorkspace" Style="{StaticResource AuroraNav}" Click="WorkspaceNavigate_Click" AutomationProperties.Name="Блоки (ECU)" ToolTipService.ToolTip="Блоки (ECU)">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="18" />
                                <TextBlock x:Name="ShellNavEcuLabel" Text="Блоки (ECU)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="SidebarFooter" Grid.Row="1" Padding="22,18" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="WINUI 3 · .NET 10" FontSize="10" Foreground="#80A5C3" />
                    <TextBlock x:Name="SidebarFooterLocale" Text="AURORA · ЕДИНОЕ ПРИЛОЖЕНИЕ" FontSize="11" Foreground="#80A5C3" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <local:AuroraHome x:Name="AuroraLanding" Visibility="Collapsed" />
            <Grid x:Name="AuroraWorkspaceHost" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkspaceHeaderGrid" Margin="24,12,24,12" ColumnSpacing="20" MinHeight="132">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Actual Dvinholm scenic banner, already included in the application package.
                         Northern-light ribbons remain decorative and must never imply CAN state. -->
                    <Border x:Name="AuroraHeaderArtwork" Grid.RowSpan="2" Grid.ColumnSpan="2"
                            Margin="-12,-8,-12,-8" CornerRadius="12" BorderThickness="1"
                            BorderBrush="#326A8D" IsHitTestVisible="False">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="ms-appx:///Assets/Dvinholm-Banner.png"
                                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                            </Grid.Background>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#EC07182C" Offset="0" />
                                        <GradientStop Color="#DA09203A" Offset="0.42" />
                                        <GradientStop Color="#910B2138" Offset="0.74" />
                                        <GradientStop Color="#660B1930" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Viewbox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill"
                                     Opacity="0.32">
                                <Canvas Width="920" Height="145">
                                    <Path Data="M200,21 C345,1 445,63 587,17 C682,-10 772,34 902,11"
                                          Stroke="#19E5BD" StrokeThickness="22" Opacity="0.50" Fill="Transparent" />
