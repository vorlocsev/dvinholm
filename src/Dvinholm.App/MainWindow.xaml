<Window
    x:Class="Dvinholm.App.MainWindow"
    Title="Dvinholm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dvinholm.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#071827">
        <local:AuroraHome x:Name="AuroraLanding"/>
        <!-- The tested legacy diagnostic controls remain intact and usable,
             but are opened on demand from the new Aurora home page. -->
        <Grid x:Name="AuroraWorkspaceHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#102A45" Padding="15,7"
                    BorderBrush="#265A83" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Content="←  На главную" Click="DashboardReturn_Click"
                            Background="#135D9E"/>
                    <TextBlock Text="DVINHOLM  /  РАБОЧЕЕ ПРОСТРАНСТВО"
                               VerticalAlignment="Center" FontWeight="Bold"
                               Foreground="#E5F1FF"/>
                </StackPanel>
            </Border>
            <Grid x:Name="RootLayout" Grid.Row="1" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Adapter diagnostics remain visible only in the local workspace.
             Do not mirror driver-supplied version strings to Aurora activity. -->
        <TextBlock x:Name="AdapterMetadataText" Grid.Row="0"
                   Text="J2534 adapter details: disconnected."
                   FontSize="12" Foreground="#C1D7E8"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   ToolTipService.ToolTip="Unverified values returned by the driver. Local diagnostic details, not an ECU identity or authorization." />

        <!-- Update controls belong exclusively to Launcher.exe. -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="86"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <TextBox x:Name="DllPath" PlaceholderText="Path to 32-bit J2534 DLL" Header="J2534 DLL"/>
            <ComboBox x:Name="J2534Devices" Grid.Column="1" Header="Registered adapters" DisplayMemberPath="Label" PlaceholderText="Select adapter" SelectionChanged="J2534Device_SelectionChanged"/>
            <Button Grid.Column="2" Content="Refresh" Click="RefreshJ2534Devices_Click" VerticalAlignment="Bottom"/>
            <ComboBox x:Name="BaudRate" Grid.Column="3" Header="CAN speed" SelectedIndex="0"
                      ToolTipService.ToolTip="Volvo XC90 P2 HS-CAN guidance: through model year 2004 250 kbit/s; from model year 2005 500 kbit/s. Other networks differ. Verify actual model year, bus and adapter before connecting; Dvinholm does not adjust the speed automatically.">
                <ComboBoxItem Content="500 kbit/s" Tag="500000"/><ComboBoxItem Content="250 kbit/s" Tag="250000"/><ComboBoxItem Content="125 kbit/s" Tag="125000"/>
            </ComboBox>
            <Button x:Name="ConnectButton" Grid.Column="4" Content="Connect" Click="Connect_Click" VerticalAlignment="Bottom"/>
            <Button x:Name="StartButton" Grid.Column="5" Content="Start monitor" Click="Start_Click" VerticalAlignment="Bottom" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="5">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/>
                <ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UdsRequestId" Header="UDS request ID" Text="" PlaceholderText="enter verified TX ID" TextChanged="SnapshotCanIdTextChanged"
                     ToolTipService.ToolTip="No request ID is selected by default. Enter a source-verified ID manually; passive ECU scanning does not prove a TX address."/>
            <TextBox x:Name="UdsResponseId" Grid.Column="1" Header="UDS response ID" Text="" PlaceholderText="enter RX ID" TextChanged="SnapshotCanIdTextChanged"
                     ToolTipService.ToolTip="Enter an independently verified response ID or explicitly select an observed passive response; observation alone does not identify an ECU."/>
            <ComboBox x:Name="CanIdFormat" Grid.Column="2" Header="CAN ID format" SelectedIndex="0" SelectionChanged="SnapshotCanIdFormatChanged">
                <ComboBoxItem Content="11-bit" Tag="standard"/>
                <ComboBoxItem Content="29-bit" Tag="extended"/>
            </ComboBox>
            <TextBox x:Name="UdsDid" Grid.Column="3" Header="DID (hex)" Text="F190" PlaceholderText="e.g. F190" TextChanged="UdsDid_TextChanged"/>
            <Button Grid.Column="4" Content="Read DID" Click="ReadDid_Click" VerticalAlignment="Bottom" x:Name="ReadDidButton" IsEnabled="False"/>
            <Button x:Name="ReadVinButton" Grid.Column="5" Content="Read VIN" IsEnabled="False" Click="ReadVin_Click" VerticalAlignment="Bottom"/>
            <Button x:Name="ReadDtcButton" Grid.Column="6" Content="Read DTC" IsEnabled="False" Click="ReadDtc_Click" VerticalAlignment="Bottom"/>
            <Button x:Name="CancelUdsButton" Grid.Column="7" Content="Cancel UDS" IsEnabled="False" Click="CancelUds_Click" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="UdsReadinessHint" Grid.Row="1" Grid.ColumnSpan="8"
                       Text="Read-only UDS disabled until connected with manually checked request and response CAN IDs."
                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       ToolTipService.ToolTip="Valid CAN ID syntax does not verify ECU identity, model, protocol or service access."/>
        </Grid>

        <Grid Grid.Row="3" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="DiscoverButton" Content="Discover ECUs" Click="Discover_Click" IsEnabled="False"/>
                <ComboBox x:Name="EcuSelector" Grid.Column="1" PlaceholderText="Observed response"
                          IsEnabled="False" SelectionChanged="EcuSelector_SelectionChanged"
                          ToolTipService.ToolTip="Selection does not send a request or verify the inferred request address."/>
                <TextBlock x:Name="DiscoveryStatus" Grid.Column="2" VerticalAlignment="Center" Text="Not scanned"/>
                <Button x:Name="CancelDiscoveryButton" Grid.Column="3" Content="Cancel scan" Click="CancelDiscovery_Click" IsEnabled="False"/>
            </Grid>
            <ListView x:Name="EcusView" Grid.Row="1" Height="76" SelectionMode="Single"
                      IsEnabled="False" SelectionChanged="Ecu_SelectionChanged"
                      ToolTipService.ToolTip="Passive response observations only. No verified ECU identity or request ID.">
                <ListView.Header><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Observed RX"/><TextBlock Grid.Column="1" Text="Guessed TX"/><TextBlock Grid.Column="2" Text="Type"/><TextBlock Grid.Column="3" Text="Frames"/><TextBlock Grid.Column="4" Text="Max bytes / ID basis"/></Grid></ListView.Header>
                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Response}"/><TextBlock Grid.Column="1" Text="{Binding Request}"/><TextBlock Grid.Column="2" Text="{Binding Type}"/><TextBlock Grid.Column="3" Text="{Binding Frames}"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding MaxPayload}"/><TextBlock Text="{Binding RequestBasis}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Row="2" MaxHeight="86" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="EcuSelectionInfo"
                           Text="Passive scan only. Select a completed observation; verify and enter the request ID manually."
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </ScrollViewer>
            <Border Grid.Row="3" Padding="8" Margin="0" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <!-- Separate filtering from actions; keep the metadata scrollable
                     and the CAN monitor visible in a compact window. -->
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileSearch" Grid.Column="0"
                                 Header="Find ECU profile"
                                 PlaceholderText="Name, ID, CAN ID, DID or source"
                                 TextChanged="ProfileSearch_TextChanged"/>
                        <ComboBox x:Name="ProfileSelector" Grid.Column="1"
                                  Header="ECU profiles" PlaceholderText="Select profile"
                                  SelectionChanged="ProfileSelector_SelectionChanged"/>
                        <CheckBox x:Name="MarkedVerifiedOnly" Grid.Column="2"
                                  Content="Marked verified only"
                                  Checked="MarkedVerifiedOnly_Changed"
                                  Unchecked="MarkedVerifiedOnly_Changed"
                                  VerticalAlignment="Bottom"/>
                    </Grid>
                    <!-- Two compact action rows replace a seven-button horizontal
                         strip which overflowed narrower app windows. All controls
                         stay reachable without horizontal scrolling. -->
                    <Grid x:Name="ProfileActionsPanel" Grid.Row="1" RowSpacing="6" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CreateProfileButton" Grid.Row="0" Grid.Column="0"
                                Content="New profile" HorizontalAlignment="Stretch"
                                Click="CreateProfile_Click"/>
                        <Button x:Name="EditProfileButton" Grid.Row="0" Grid.Column="1"
                                Content="Edit selected" HorizontalAlignment="Stretch"
                                Click="EditProfile_Click" IsEnabled="False"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="Import JSON" HorizontalAlignment="Stretch"
                                Click="ImportProfiles_Click"/>
                        <Button Grid.Row="0" Grid.Column="3"
                                Content="Export JSON" HorizontalAlignment="Stretch"
                                Click="ExportProfiles_Click"/>
                        <Button x:Name="CaptureSnapshotButton" Grid.Row="1"
                                Grid.Column="0" Grid.ColumnSpan="2"
                                Content="Read + save snapshot" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Read selected profile DIDs and explicitly save a diagnostic JSON file. Not a restorable ECU backup."
                                Click="CaptureSnapshot_Click" IsEnabled="False"/>
                        <Button x:Name="InspectSnapshotButton" Grid.Row="1" Grid.Column="2"
                                Content="Inspect snapshot" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Inspect local DID JSON without connecting, transmitting CAN, or restoring ECU data."
                                Click="InspectSnapshot_Click"/>
                        <Button x:Name="CompareSnapshotsButton" Grid.Row="1" Grid.Column="3"
                                Content="Compare snapshots" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Compare two local diagnostic JSON snapshots offline. Show only changed DID numbers, not their data."
                                Click="CompareSnapshots_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" MaxHeight="76"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="EcuInfoText"
                                   Text="No ECU profile selected"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                    <Button x:Name="P2ConfigCatalogButton" Grid.Row="3"
                            Content="P2 configuration candidates (offline)"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="View vendor-advertised Volvo XC90 P2 option names offline; no vehicle queries, PIN, editing or writes."
                            Click="P2ConfigCatalog_Click"/>
                    <Button x:Name="P2PinReviewButton" Grid.Row="4"
                            Content="P2 CEM PIN readiness (offline review)"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Cancellable offline evidence checklist only. No PIN extraction, credential entry or vehicle operation."
                            Click="P2PinReview_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Populated solely by the opt-in Development build. -->
            <Grid x:Name="DeveloperMonitorHost" Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="75"/><ColumnDefinition Width="125"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBox x:Name="IdFilter" Header="ID filter (hex)" PlaceholderText="7E0,7E8" TextChanged="Filter_Changed"/>
                <Button Grid.Column="1" Content="Clear" Click="Clear_Click" VerticalAlignment="Bottom"/>
                <Button x:Name="HardwareFilterButton" Grid.Column="2" Content="Apply HW filter" Click="HardwareFilter_Click" VerticalAlignment="Bottom" IsEnabled="False"/>
                <Button Grid.Column="3" Content="CSV log" Click="Csv_Click" VerticalAlignment="Bottom"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="RX summary" Click="CanRxSummary_Click"
                            ToolTipService.ToolTip="Review buffered CAN RX ID/DLC counts without frame data. Copy only by explicit approval. No diagnostic requests."/>
                    <Button Content="Inspect CSV" Click="InspectCanCsv_Click"
                            ToolTipService.ToolTip="Offline review of a user-selected CAN CSV. No connection or monitor changes. Payload and CAN IDs hidden in the report."/>
                    <TextBlock x:Name="FrameRateText" VerticalAlignment="Center" Text="0 frames/s"/>
                </StackPanel>
                <TextBlock x:Name="FrameCountText" Grid.Column="5" VerticalAlignment="Center" Text="0 shown / 0 rx" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DroppedFrameText" Grid.Column="6" VerticalAlignment="Center" Text="0 dropped" HorizontalAlignment="Right"/>
            </Grid>
            <ListView x:Name="FramesView" Grid.Row="2" SelectionMode="None">
                <ListView.Header><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Timestamp (ms)"/><TextBlock Grid.Column="1" Text="ID"/><TextBlock Grid.Column="2" Text="Type"/><TextBlock Grid.Column="3" Text="DLC"/><TextBlock Grid.Column="4" Text="Data"/></Grid></ListView.Header>
                <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}"/><TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas"/><TextBlock Grid.Column="2" Text="{Binding Type}"/><TextBlock Grid.Column="3" Text="{Binding Dlc}"/><TextBlock Grid.Column="4" Text="{Binding Data}" FontFamily="Consolas"/></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Padding="10" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel x:Name="StatusPanel" Spacing="6">
                <!-- Explicit diagnostic payloads stay inside the workspace.
                     The Aurora last-event summary sees only payload-free status. -->
                <Expander x:Name="DiagnosticResultExpander"
                          Header="Diagnostic read result (VIN / DID / DTC, review before sharing)"
                          IsExpanded="False">
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DiagnosticResultText"
                                   Text="No completed UDS read in this session."
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontFamily="Consolas"/>
                    </ScrollViewer>
                </Expander>
                <Button x:Name="ClearDiagnosticResultButton"
                        Content="Clear diagnostic result"
                        HorizontalAlignment="Right"
                        Click="ClearDiagnosticResult_Click"
                        ToolTipService.ToolTip="Clear the last VIN/DID/DTC payload and ignore any pending result. Does not contact the ECU."/>
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="StatusText" Text="Disconnected" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>