<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Dvinholm.App</RootNamespace>
    <!-- Current Development may share 0.2.4 binary version; published Stable v0.2.4 remains frozen at a9e6188. -->
    <Version>0.2.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Dvinholm.ico</ApplicationIcon>
    <!-- Transitional: legacy release CI explicitly selects x86, new unified app explicitly selects x64. -->
    <Platforms>x86;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x64'">x86</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'x64'">win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Keep WinUI/XAML/COM safe from unvalidated linker removal. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <!-- Stable Release defaults to no developer tools. Development must opt in explicitly. -->
    <DvinholmDevelopmentFeatures Condition="'$(DvinholmDevelopmentFeatures)' == '' and '$(Configuration)' == 'Debug'">true</DvinholmDevelopmentFeatures>
    <DvinholmDevelopmentFeatures Condition="'$(DvinholmDevelopmentFeatures)' == ''">false</DvinholmDevelopmentFeatures>
    <DefineConstants Condition="'$(DvinholmDevelopmentFeatures)' == 'true'">$(DefineConstants);DVINHOLM_DEVELOPMENT_FEATURES</DefineConstants>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DvinholmMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackage>true</AppxPackage>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <DefineConstants>$(DefineConstants);DVINHOLM_MSIX</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DvinholmMsix)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\Msix*.png" />
  </ItemGroup>
  <!-- Do not ship synthetic generators/report fixtures in any default Release build. -->
  <ItemGroup Condition="'$(DvinholmDevelopmentFeatures)' != 'true'">
    <Compile Remove="CanDemoFrameGenerator.cs" />
    <Compile Remove="UdsOfflineSample.cs" />
    <Compile Remove="UdsOfflineTextReport.cs" />
    <Compile Remove="ExperimentalCemPinCanProvider.cs" />
    <Compile Remove="CemPinStore.cs" />
    <Compile Remove="CemPinWindowsProtection.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\Dvinholm.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\dvinholm-banner.webp" Link="Assets\Dvinholm-Banner.webp" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\dvinholm-banner.png" Link="Assets\Dvinholm-Banner.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Reuse the user-approved No. 9 gear / gull emblem, never a generated placeholder. -->
    <Content Include="..\..\assets\launcher-northern-emblem.svg" Link="Assets\Launcher-Northern-Emblem.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
