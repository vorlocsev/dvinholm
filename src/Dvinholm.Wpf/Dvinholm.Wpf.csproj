<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dvinholm.Wpf</RootNamespace>
    <AssemblyName>Dvinholm.Wpf</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\Dvinholm.App\Assets\Dvinholm.ico</ApplicationIcon>
    <Version>0.2.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse proven, read-only core logic; no WinUI or Windows App SDK references. -->
    <Compile Include="..\Dvinholm.App\J2534DeviceDiscovery.cs" Link="Shared\J2534DeviceDiscovery.cs"/>
    <Compile Include="..\Dvinholm.App\UpdateSourcePreferenceStore.cs" Link="Shared\UpdateSourcePreferenceStore.cs"/>
  </ItemGroup>
</Project>
